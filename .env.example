# Spotify app client ID (public; PKCE flow — never put a client secret in frontend code).
# Create an app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered in your Spotify app settings.
# Spotify requires HTTPS or a loopback IP literal (127.0.0.1), not "localhost".
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
